# --- Database ---
# Superuser connection: migrations and seeding only (needs DDL + CREATE ROLE).
DATABASE_URL=postgres://ozimai:ozimai_dev@localhost:5433/ozimai
# Restricted, non-superuser role the running app actually connects as — this
# is the connection RLS policies apply to. Created by the InitSchema
# migration. Never point the app itself at DATABASE_URL above.
APP_DATABASE_URL=postgres://ozimai_app:ozimai_app_dev@localhost:5433/ozimai
# Password the migration assigns to the ozimai_app role when it first creates
# it. REQUIRED (set to something strong) on any deployed environment whose
# Postgres is publicly reachable, e.g. Railway. Keep APP_DATABASE_URL's
# password in sync with this. Defaults to the dev password if unset.
APP_DB_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=dev-only-change-me
# Login is a 4-digit code sent by email via Resend (resend.com). Without a
# key the code is printed in the backend log (dev only; production refuses
# to issue codes without it). MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=OzimAI <noreply@ozimai.kz>

# --- AI / LLM Router ---
# Leave unset to run entirely on the deterministic MockProvider (fallback).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# --- WhatsApp Cloud API (real BSP credentials, optional) ---
# Optional channel. Leave unset to use web chat + SMS/push reminders only;
# WhatsApp patients' reminders then fall back to SMS.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Web chat (embeddable widget + /c/<slug> page) ---
# Public base URL of this deployment; used in SMS/push reminder links back to
# the clinic's chat. e.g. https://ozimai.up.railway.app
PUBLIC_APP_URL=
# Optional separate signing secret for visitor chat tokens (defaults to a
# value derived from JWT_SECRET; never the same key as panel tokens).
WEBCHAT_JWT_SECRET=
# Fallback clinic time zone (each clinic also has its own organization.time_zone).
CLINIC_TIMEZONE=Asia/Almaty
# Platform owner(s): may rename companies and set their logos ("Компании" screen).
# Comma-separated emails; they sign in with the normal email code.
SUPER_ADMIN_EMAILS=

# --- Reminders: SMS ---
# Each clinic gets 500 SMS segments per calendar month by default
# (organization.sms_monthly_limit; change per clinic in SQL).
# console (log only, default) | mobizon
SMS_PROVIDER=console
MOBIZON_API_KEY=
MOBIZON_API_DOMAIN=api.mobizon.kz
# Registered alpha sender name (must be approved by KZ operators first).
SMS_SENDER=

# --- Reminders: browser push (Web Push / VAPID, no Firebase needed) ---
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# --- Billing (Kaspi Pay, optional) ---
KASPI_MERCHANT_ID=
KASPI_API_KEY=

# --- Backend server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Proxy hops in front of the backend (Railway = 1). Keeps per-IP rate limits
# on the real visitor IP.
TRUST_PROXY=1

# --- Frontend build (Vercel) ---
# Backend origin the browser calls directly, e.g. https://api.ozimai.kz.
# Leave empty locally (Vite proxies /api) or when the backend serves the SPA.
VITE_API_ORIGIN=
